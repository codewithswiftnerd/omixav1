# --- Core ---
OMIXA_SECRET_KEY=change-me-long-random
OMIXA_PUBLIC_BASE_URL=https://getomixa.com
# Hostnames that 301 to the base URL (GET/HEAD only). Default = the three Railway hostnames. Allowlist, comma-separated.
# OMIXA_REDIRECT_HOSTS=omixaa.up.railway.app,web-production-888aa.up.railway.app,web-production-01c985.up.railway.app

# --- Email (Namecheap Private Email). Set these in Railway Variables; NEVER commit real values. See docs/EMAIL.md ---
# 465 = implicit SSL (below). For 587 use SMTP_PORT=587, SMTP_USE_SSL=false, SMTP_USE_TLS=true. Never both true.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USERNAME=support@getomixa.com
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_USE_TLS=false
MAIL_DEFAULT_SENDER=support@getomixa.com
# Optional: OMIXA_SUPPORT_EMAIL (public address, default support@getomixa.com), CONTACT_FORM_RECIPIENT (default = support address),
# SMTP_TIMEOUT_SECONDS=10, RATE_LIMIT_CONTACT_PER_MINUTE=3, RATE_LIMIT_CONTACT_PER_HOUR=10, RATE_LIMIT_CONTACT_GLOBAL_PER_HOUR=60,
# RATE_LIMIT_RESET_EMAIL_PER_MINUTE=5, RATE_LIMIT_RESET_EMAIL_PER_ADDRESS_HOUR=3

# Retry (welcome/reset/billing emails) and expiry reminders (scripts/send_expiry_reminders.py, run daily):
# MAIL_RETRY_ATTEMPTS=3, MAIL_RETRY_BASE_SECONDS=5, MAIL_EXPIRY_REMINDER_DAYS=3

# --- Plans / limits ---
OMIXA_FREE_MAX_UPLOAD_MB=10
OMIXA_PRO_MAX_UPLOAD_MB=25

# --- Firebase (server) ---
FIREBASE_PROJECT_ID=your-project-id
# The whole service-account JSON on one line. NEVER commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
# PUBLIC web config for the sign-in page (safe to expose): {"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}
FIREBASE_WEB_CONFIG_JSON=

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_live_or_test_xxx
PAYSTACK_PLAN_MONTHLY=PLN_xxx
PAYSTACK_PLAN_ANNUAL=PLN_xxx
# Prices are set in USD. The naira amount follows the live USD->NGN rate automatically (utils/fx.py): no edit needed when
# the dollar moves, and the Paystack plan amount is kept in step for NEW subscribers (OMIXA_PAYSTACK_AUTO_PRICE).
OMIXA_PRICE_USD_MONTHLY=5
OMIXA_PRICE_USD_ANNUAL=50
# Leave these EMPTY to use the live rate. They are only a last-resort fallback (or the whole price if OMIXA_FX_MODE=fixed).
OMIXA_PRICE_NGN_MONTHLY=
OMIXA_PRICE_NGN_ANNUAL=
# Optional live-rate tuning (defaults shown):
# OMIXA_FX_MODE=auto                  # auto | fixed
# OMIXA_FX_URL=https://open.er-api.com/v6/latest/USD
# OMIXA_FX_CACHE_SECONDS=21600        # refresh at most every 6 hours
# OMIXA_FX_FALLBACK_USD_NGN=          # used only if no live rate was ever obtained
# OMIXA_FX_BUFFER_PERCENT=0           # cushion on top of the rate, e.g. 3
# OMIXA_FX_ROUND_TO_NGN=100
# OMIXA_PAYSTACK_AUTO_PRICE=true      # keep the charged plan amount within the tolerance of the live price
# OMIXA_PAYSTACK_AUTO_PRICE_TOLERANCE_PERCENT=2

# --- TEMPORARY pre-launch access gate (docs/ACCESS_GATE_AND_FX.md). Set in Railway Variables; NEVER commit real values. ---
# OMIXA_ACCESS_GATE_ENABLED=true
# OMIXA_ACCESS_GATE_PASSWORD=          # the team password, 12+ characters
# OMIXA_ACCESS_GATE_SECRET=            # cookie-signing secret, 32+ random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
# OMIXA_ACCESS_GATE_OPEN_AT=2026-11-13T00:00:00+01:00   # optional: the gate switches itself off at this moment
# OMIXA_ACCESS_GATE_SCOPE=app          # app (default): public SEO pages stay open | site: lock everything (hides from Google)
# OMIXA_ACCESS_GATE_SESSION_HOURS=12

# ======================= Scalability (all optional; defaults = old single-instance behaviour) =======================
# OMIXA_PROCESSING_MODE=queue            # inline (default) | queue (API enqueues, worker.py cleans)
# DATABASE_URL=postgresql://user:pass@host:5432/omixa   # empty = SQLite (single instance only)
# REDIS_URL=redis://host:6379/0          # distributed rate limiting, queue delivery, caches
# OMIXA_STORAGE_BACKEND=s3               # local (default) | s3 (any S3-compatible, PRIVATE bucket)
# OMIXA_S3_BUCKET=omixa-jobs
# OMIXA_S3_ENDPOINT_URL=                 # R2/B2/MinIO endpoint; empty for AWS S3
# OMIXA_S3_REGION=auto
# OMIXA_S3_ACCESS_KEY_ID=                # secrets: set in the platform, never commit
# OMIXA_S3_SECRET_ACCESS_KEY=
# OMIXA_S3_SSE=AES256                    # empty if the provider rejects the header
# OMIXA_MAX_CELLS=3000000                # rows x columns ceiling (memory + CPU guard)
# OMIXA_JOB_TIMEOUT_SECONDS=900          # hard per-job limit in the worker
# OMIXA_JOB_MEMORY_LIMIT_MB=1536         # per-job address-space cap (Linux), 0 = off
# OMIXA_JOB_MAX_ATTEMPTS=3
# OMIXA_QUEUE_SOFT_LIMIT=200             # above: "high traffic" message
# OMIXA_QUEUE_HARD_LIMIT=5000            # above: 503 + Retry-After
# OMIXA_MAX_ACTIVE_JOBS_ANON=2           # per-principal queued+running jobs (USER=3, PRO=8)
# OMIXA_GLOBAL_MAX_RUNNING=50
# RATE_LIMIT_USER_PER_MINUTE=120         # also: _PRO_ _UPLOAD_ _PROCESS_ _STATUS_ _PAYMENT_ _ADMIN_
# OMIXA_LOG_FORMAT=json
# OMIXA_METRICS_TOKEN=                   # enables /api/metrics (Bearer token)

# --- Production storage (REQUIRED when OMIXA_PROCESSING_MODE=queue and FLASK_ENV=production) ---
# API instances and workers are different machines: uploads/results live in object storage and job
# state in PostgreSQL. Local disk + SQLite are for development / a deliberate single node only
# (OMIXA_ALLOW_SINGLE_NODE=1).
# OMIXA_PROCESSING_MODE=queue
# OMIXA_STORAGE_BACKEND=s3
# OMIXA_S3_BUCKET=...            OMIXA_S3_ENDPOINT_URL=...   OMIXA_S3_REGION=...
# OMIXA_S3_ACCESS_KEY_ID=...     OMIXA_S3_SECRET_ACCESS_KEY=...
# DATABASE_URL=postgresql://...
# REDIS_URL=redis://...

# --- Pro batch processing (all server-enforced; shown values are the defaults) ---
# OMIXA_BATCH_MAX_FILES=20
# OMIXA_BATCH_MAX_TOTAL_MB=100
# OMIXA_BATCH_MAX_FILE_MB=0              # 0 = use OMIXA_PRO_MAX_UPLOAD_MB
# OMIXA_BATCH_MAX_CELLS_PER_FILE=0       # 0 = use OMIXA_MAX_CELLS
# OMIXA_BATCH_MAX_TOTAL_CELLS=10000000
# OMIXA_BATCH_MAX_CONCURRENT_FILES=3     # files of one batch queued/running at once
# OMIXA_BATCH_MAX_ACTIVE_PER_USER=2      # unfinished batches per user
# OMIXA_BATCH_TIMEOUT_SECONDS=3600       # waiting files are cancelled after this
# OMIXA_BATCH_RETENTION_SECONDS=86400    # batch outputs are deleted after this

# Independent worker processes one `python worker.py` container supervises (default 1; max 16).
# Concurrency = replicas x this. Peak memory ~ this x OMIXA_JOB_MEMORY_LIMIT_MB.
# OMIXA_WORKER_PROCESSES=2
