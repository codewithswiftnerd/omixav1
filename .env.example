# Copy this file to .env and fill in real values before deploying anywhere
# public. Never commit the real .env file (it's already in .gitignore).

# --- Environment --------------------------------------------------
# "production" (the default if unset) enforces: a real OMIXA_SECRET_KEY
# is required, session cookies are Secure by default, HSTS is sent.
# Set to "development" only for local work.
FLASK_ENV=production

# --- Sessions / CSRF (required in production) ----------------------
# Signs the session cookie and CSRF tokens. Must be the SAME value on
# every gunicorn worker and stay stable across restarts (see
# config.py's docstring for why). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OMIXA_SECRET_KEY=

# SameSite for the session cookie. "Lax" (default) is right for a
# same-origin deploy. A separately hosted frontend needs "None" (and
# HTTPS everywhere) — see "Cross-origin deploys" below.
OMIXA_SESSION_SAMESITE=Lax

# --- Admin dashboard (required to use /admin) -----------------------
# Single operator account, no user table. With either left unset,
# /admin is unreachable (login always fails closed), it does not
# fall back to being open. Generate the hash with:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('your-password'))"
OMIXA_ADMIN_USERNAME=
OMIXA_ADMIN_PASSWORD_HASH=

# --- CORS -------------------------------------------------------------
# Comma-separated list of origins allowed to call the API cross-origin,
# e.g. https://omixa.app,https://app.omixa.app. Leave as * for local
# dev / same-origin deploys — but note session cookies are NEVER sent
# cross-origin to a wildcard: a split frontend/backend deploy must set
# this to the frontend's real origin(s) for login/job ownership to
# work at all. See "Cross-origin deploys" below.
ALLOWED_ORIGINS=*

# --- Rate limiting ------------------------------------------------
# Requests per IP per minute. 0 disables. General /api/* traffic vs.
# admin login attempts are separate buckets, see config.py.
RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT_PER_MINUTE=8

# --- Storage ------------------------------------------------------
# Where uploaded/cleaned files and the metadata sqlite db live. Both
# default to paths inside the app directory; override if your
# platform gives you a separate persistent/ephemeral volume.
# OMIXA_TEMP_DIR=
# OMIXA_DB_PATH=
OMIXA_MAX_UPLOAD_MB=25

# --- Runtime ----------------------------------------------------------
# Never set this to 1 in production — enables Werkzeug's interactive
# debugger, which allows arbitrary code execution from the browser.
FLASK_DEBUG=0
PORT=5000

# --- Cross-origin deploys -------------------------------------------
# If the frontend is hosted separately from this backend (e.g.
# frontend on Netlify, backend on Render/Railway):
#   1. Set ALLOWED_ORIGINS to the frontend's exact origin(s).
#   2. Set OMIXA_SESSION_SAMESITE=None (browsers only honor SameSite=
#      None cookies over HTTPS, so both sides need TLS).
#   3. Point the frontend's static/js/config.js OMIXA_API_BASE at
#      this backend's URL.
# Same-origin deploys (this Flask app serving its own templates, the
# default) need none of this — the defaults above already work.
