# --- Core ---
OMIXA_SECRET_KEY=change-me-long-random
OMIXA_PUBLIC_BASE_URL=https://your-domain.example

# --- Plans / limits ---
OMIXA_FREE_MAX_UPLOAD_MB=10
OMIXA_PRO_MAX_UPLOAD_MB=25

# --- Firebase (server) ---
FIREBASE_PROJECT_ID=your-project-id
# The whole service-account JSON on one line. NEVER commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
# PUBLIC web config for the sign-in page (safe to expose): {"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}
FIREBASE_WEB_CONFIG_JSON=

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_live_or_test_xxx
PAYSTACK_PLAN_MONTHLY=PLN_xxx
PAYSTACK_PLAN_ANNUAL=PLN_xxx
# Display only; Paystack charges the NGN amount configured on each plan code.
OMIXA_PRICE_USD_MONTHLY=5
OMIXA_PRICE_USD_ANNUAL=50
OMIXA_PRICE_NGN_MONTHLY=
OMIXA_PRICE_NGN_ANNUAL=
